# Vorlage fuer die Umgebungsdatei.
#
# So nimmst du sie in Betrieb:
#   cp .env.example .env
#
# Die echte .env steht in .gitignore und wird NIE eingecheckt. Diese Vorlage hier ist
# die einzige, die im Repo liegt: wer den Fork frisch klont, kommt nur mit ihr hoch.
# Fuer die Uebungsumgebung sind die Werte absichtlich einfach.

# --- PostgreSQL -------------------------------------------------------------
# Diese drei liest sowohl der Postgres-Container beim Anlegen der Datenbank
# als auch jeder Dienst, der sich mit ihr verbindet.
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_DEFAULT_USER=chat
RABBITMQ_DEFAULT_PASS=chat

# --- batch-writer: Buendelung ----------------------------------------------
# Wie viele Nachrichten hoechstens in ein Paket gehen. Ein INSERT mit 500 Zeilen
# statt 500 einzelnen Anweisungen.
BATCH_WRITER_BATCH_SIZE=500

# Wie lange auf ein volles Paket gewartet wird, in Millisekunden. Laeuft die Zeit ab,
# wird das Paket geschrieben, auch wenn es nicht voll ist. Sonst bliebe bei wenig
# Betrieb eine einzelne Nachricht ewig liegen.
BATCH_WRITER_BATCH_TIMEOUT_MS=200

# Pause nach einem Datenbankfehler, in Millisekunden, bevor dasselbe Paket erneut
# versucht wird. Ohne diese Pause wuerde der Dienst in einer heissen Schleife laufen.
BATCH_WRITER_RETRY_BACKOFF_MS=5000

# --- chat-service: Live-Queue -----------------------------------------------
# Jede chat-service-Instanz hat ihre eigene Queue fuer die Live-Anzeige. Hoechstens so
# viele Nachrichten liegen darin. Holt eine haengende Instanz nichts mehr ab, verwirft
# der Broker ab dieser Grenze die AELTESTE Nachricht, statt vollzulaufen.
LIVE_QUEUE_MAX_LENGTH=1000

# Nach so vielen Millisekunden verfaellt eine Live-Nachricht, die niemand abgeholt hat.
# Fuer die Live-Anzeige ist sie danach ohnehin veraltet; gespeichert ist sie trotzdem,
# denn chat.persist bekommt ihre eigene Kopie.
LIVE_QUEUE_TTL_MS=30000
